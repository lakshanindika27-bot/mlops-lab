{
  "title": "MLOps API v2",
  "uid": "mlops-api-v2",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests/sec",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(predictions_total[1m]))", "refId": "A" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Predictions by class",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "expr": "sum by (label) (rate(predictions_total[1m]))", "legendFormat": "{{label}}", "refId": "A" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(predict_latency_seconds_bucket[5m])))", "refId": "A" } ]
    }
  ]
}
